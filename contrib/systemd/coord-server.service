# coord v2 server with mTLS (see README "Coordination v2" > Network).
# Install: cp contrib/systemd/*.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now coord-server
# --pki: client certs are checked against management on every request (revocation is
# immediate) and renewed automatically once 15 days old.
[Unit]
Description=coord coordination server (mTLS, 127.0.0.1:1337)

[Service]
WorkingDirectory=%h/dev/coord
ExecStart=%h/dev/coord/.venv/bin/coord-server --pki pki
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
